# ---------- Shared ----------
# Prisma connects with this. Docker Compose Postgres (npm run db:up) listens on 5433.
# For a local Postgres install use e.g. postgres://postgres:YOUR_PASSWORD@localhost:5432/qr_platform
# (npm run migrate creates the database if it doesn't exist).
DATABASE_URL=postgres://qr:qr@localhost:5433/qr_platform

# Optional. Leave empty to use an in-memory cache in the resolver (fine for local dev).
REDIS_URL=

# ---------- Ports ----------
# Local ports are fixed in the root package.json under "ports" (web 6060, API 6061,
# QR redirect 6062). Change them there. The addresses below are worked out from those
# ports, so only set them for a real deployment (a public domain or your PC's network
# address so phones can scan):
# QR_BASE_URL=https://qr.example.com        (where printed codes point; /q/:code)
# WEB_BASE_URL=https://app.example.com      (public web app: /m/:menuId, /e/:eventId)
# API_PUBLIC_URL=https://api.example.com    (payment webhooks)
# API_INTERNAL_URL=http://localhost:6061    (how the web server reaches the API)

# ---------- API (apps/api) ----------
JWT_SECRET=change-me-to-a-long-random-string
# Salt for hashing visitor IPs in scan analytics (never store raw IPs)
SCAN_IP_SALT=change-me-too

# Email. Leave SMTP_HOST empty in dev: verification codes are printed to the API console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="QR Platform <no-reply@example.com>"

# SMS (optional). Codes are also texted when a user gives a phone number.
# SMS_PROVIDER=arkesel  -> set SMS_API_KEY
# SMS_PROVIDER=hubtel   -> set SMS_CLIENT_ID and SMS_CLIENT_SECRET
# Leave SMS_PROVIDER empty to print SMS messages in the API terminal.
SMS_PROVIDER=
SMS_API_KEY=
SMS_CLIENT_ID=
SMS_CLIENT_SECRET=
SMS_SENDER_ID=QRPlatform

# Logging: debug | info | warn | error. Set PRISMA_LOG=query to print every SQL query.
LOG_LEVEL=info
PRISMA_LOG=

# ---------- Payments ----------
# Choose the provider in Admin → Platform settings. Keys live here.
# Test mode shows a practice checkout (no real money). It's on by default outside production.
PAYMENTS_TEST_MODE=
# Paystack: Dashboard → Settings → API Keys & Webhooks. Webhook URL: {API_PUBLIC_URL}/webhooks/paystack
PAYSTACK_SECRET_KEY=
# Hubtel: from your Hubtel merchant account. Callback URL: {API_PUBLIC_URL}/webhooks/hubtel
HUBTEL_API_ID=
HUBTEL_API_KEY=
HUBTEL_MERCHANT_ACCOUNT=

# First super admin, created by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345

# ---------- Resolver (apps/resolver) ----------
RESOLVER_CACHE_TTL_SECONDS=15

# ---------- Help assistant ----------
# Claude answers "how do I…" questions in the dashboard. Get a key at https://console.anthropic.com
# Leave empty to use simple search over the user guide instead.
ANTHROPIC_API_KEY=
HELP_BOT_MODEL=claude-haiku-5-5
HELP_BOT_MESSAGES_PER_HOUR=40
